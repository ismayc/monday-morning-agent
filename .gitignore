.DS_Store
__pycache__/
# the raw nflverse downloads (about 500 MB); ./fetch-data.sh re-creates them
episode-*/data/pbp*.csv
episode-*/data/*.gz
# the ESPN fill for games nflverse has not published yet (fetch-espn.mjs); local only
episode-*/data/espn*-slim.csv
# what your own runs produce
episode-*/rulings/
episode-*/rehearsal-runs/
# the rulings on episode 1's claim, published after the episode airs on October 12, 2026
episode-1/examples/04-run-on-screen.txt
episode-1/examples/05-ruling.md
episode-1/examples/06-ruling-declined-bet.md
